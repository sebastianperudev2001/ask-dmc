# Postgres (Azure Database for PostgreSQL Flexible Server)
DATABASE_URL=postgresql://user:password@localhost:5432/agent_service

# Azure OpenAI (embeddings)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Foundry (Persistent Agent)
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-project>.services.ai.azure.com/
# IMPORTANTE: este es el DEPLOYMENT NAME (el que elegiste al crear el deployment vía
# `AI_PROJECT_DEPLOYMENTS` en azd, campo "name"), NO necesariamente el nombre del modelo
# subyacente (campo "model.name"). Si no coinciden, la API responde 404 DeploymentNotFound
# aunque el deployment exista y esté "Running" (encontrado en esta sesión). Verificar con:
#   az cognitiveservices account deployment list --name <cuenta> --resource-group <rg>
FOUNDRY_AGENT_MODEL_DEPLOYMENT=gpt-5.4-nano

# Auth: en LOCAL se usa Azure CLI credential (az login); en PRODUCTION, Managed Identity (sin variables extra)
AGENT_SERVICE_ENV=local

# Timeout (segundos) para esperar relax_filters_response antes de descartar el estado pendiente (NFR Design PATTERN-02)
RELAX_CONFIRMATION_TIMEOUT_SECONDS=300

# Retry policy (NFR Design PATTERN-01)
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5

# Mercado Pago Checkout Pro (Incremento 2 — sandbox/test credentials)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secreto de verificación de firma de webhook (Mercado Pago -> Tus integraciones -> Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com

# Timeout (segundos) para esperar profile_data_submitted (widget de collect_profile_data)
# antes de continuar la conversación sin esos datos (NFR Design PATTERN-15 — agregado tras
# encontrar un deadlock real: sin esto, abandonar el widget sin desconectarse bloqueaba la
# conexión para siempre). Ver business-logic-model.md Sección 15.
PROFILE_DATA_TIMEOUT_SECONDS=300
